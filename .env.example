# Copia estas variables en Railway → tu servicio → Variables

# Conexión a Supabase (Settings → Database → Connection pooling, puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Texto largo y aleatorio para firmar las sesiones (mínimo 24 caracteres)
JWT_SECRET=

# Texto largo y aleatorio para cifrar las contraseñas de Wansoft (mínimo 16 caracteres)
# ¡No lo cambies después de guardar claves, o habrá que capturarlas de nuevo!
ENCRYPTION_KEY=

# Contraseña inicial del usuario "admin" (solo se usa la primera vez)
ADMIN_PASSWORD=

# Cada cuántos minutos se actualiza el inventario desde Wansoft (0 = solo manual)
SYNC_MINUTES=60

# Opcional: dirección del WebService (ya viene la oficial)
# WANSOFT_URL=https://www.wansoft.net/wansoft.web/API/IntegrationService.asmx
